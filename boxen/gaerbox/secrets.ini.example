; Copy to secrets.ini (git-ignored) and fill in. All values are optional:
; without a WiFi SSID the device opens the "TIPSYlab <id>" setup access point.
[secrets]
build_flags =
    -DTIPSY_WIFI_SSID='"MyWiFi"'
    -DTIPSY_WIFI_PASS='"wifi-password"'
    -DTIPSY_MQTT_HOST='"192.168.1.10"'
    -DTIPSY_MQTT_PORT=1883
    -DTIPSY_MQTT_USER='"mqtt-user"'
    -DTIPSY_MQTT_PASS='"mqtt-password"'
    -DTIPSY_OTA_PASS='"choose-an-ota-password"'
    -DTIPSY_AP_PASS='"treasurelab"'
ota_host = tipsy.local
ota_password = choose-an-ota-password
